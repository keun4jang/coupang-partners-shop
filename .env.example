# ─────────────────────────────────────────────────────────────
# 살림템 메모장 - 환경변수 예시
# 실제 값은 .env.local (로컬) / Vercel 환경변수 (배포)에 넣는다.
# 이 파일에는 절대 실제 키를 넣지 않는다.
# ─────────────────────────────────────────────────────────────

# 사이트 공개 URL (예: https://momitemmom.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Supabase (프로젝트 설정 > API 에서 확인)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot (@BotFather 에서 발급)
TELEGRAM_BOT_TOKEN=
# 명령을 허용할 채팅 ID (본인 chat id)
TELEGRAM_ALLOWED_CHAT_ID=
# [필수] webhook 설정 시 secret_token 으로 등록한 값 (임의의 랜덤 문자열).
# 이 값이 없으면 /api/telegram 이 모든 요청을 거부한다 (chat id 만으로는
# 요청 출처를 검증할 수 없어 인증 없이 봇 명령이 실행될 수 있기 때문).
TELEGRAM_WEBHOOK_SECRET=

# Google Drive - 업로드 대상 루트 폴더 ID (공통)
GOOGLE_DRIVE_FOLDER_ID=

# [권장] OAuth 사용자 위임 - 일반 Gmail 계정 드라이브에 업로드하려면 이 방식.
# SCOPE=drive node scripts/google-oauth.mjs 로 refresh token 을 발급받는다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# 유튜브 쇼츠 자동 업로드 - 채널 소유 구글 계정 전용(드라이브 계정과 다를 수 있음).
# 유튜브 채널이 있는 구글 계정으로 OAuth 클라이언트를 별도로 만들고,
# SCOPE=youtube node scripts/google-oauth.mjs 로 refresh token 을 발급받는다.
# (해당 구글 클라우드 프로젝트에서 YouTube Data API v3 활성화 필요)
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# [대안] 서비스 계정 - Google Workspace(공용 드라이브)에서만 업로드 가능.
# 일반 Gmail '내 드라이브' 폴더에는 업로드 불가(저장 용량 없음).
GOOGLE_CLIENT_EMAIL=
# 개인키는 줄바꿈을 \n 으로 이스케이프해서 한 줄로 넣는다
GOOGLE_PRIVATE_KEY=

# 쿠팡파트너스 Open API (스카우트 = 상품 자동 수집용)
# 파트너스 > 오픈API 에서 발급. 절대 커밋 금지(.env.local / Vercel 에만).
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 상품영상 스크래핑용 프록시 (가정용 IP 경유, 예: http://user:pass@host:port).
# 설정하면 쿠팡 상세페이지의 판매자 시연영상을 자동 수집해 배경으로 쓴다 (최우선 소스).
# 쿠팡이 서버 IP를 차단해서 주거용(residential) 프록시가 필요. 미설정 시 건너뜀.
SCRAPER_PROXY_URL=

# 알리익스프레스 어필리에이트 API - "같은 제품" 판매자 데모 영상 자동 소싱.
# portals.aliexpress.com 가입 → openservice.aliexpress.com 앱 생성 후 발급.
# 미설정 시 알리 소싱은 건너뛰고 아래 스톡영상만 사용.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# (포맷 D용) 무료 스톡영상 API - 실사용 영상 배경 자동 수급.
# 둘 중 하나만 있으면 됨 (Pexels 우선). 없으면 D 포맷은 블러 상품사진 배경으로 폴백.
# Pexels: pexels.com/api / Pixabay: pixabay.com/api/docs (가입 후 발급)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# (권장) 나레이션 음성 업그레이드 - Google Cloud TTS (Chirp3-HD, 자연스러운 음성).
# 프로젝트에서 Text-to-Speech API 활성화 필요. 없거나 실패하면 Edge 무료 음성으로 자동 폴백.
GOOGLE_TTS_API_KEY=
# 기본: ko-KR-Chirp3-HD-Kore (여성). 다른 목소리로 바꿀 때만 지정
GOOGLE_TTS_VOICE=

# 인스타그램 릴스 자동 게시 (Instagram API with Instagram Login / graph.instagram.com).
# 프로페셔널 계정 + 앱 "역할"에 Instagram 테스터로 추가(수락) + 게시 권한 토큰 생성으로 발급.
# 앱 심사/페이스북 페이지 연결 불필요. 자세한 절차는 src/lib/instagram.ts 상단 주석 참고.
# 토큰은 장기 토큰(약 60일) - 만료 전 갱신 필요.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# 페이스북 릴스 자동 게시 (선택). 페이스북 페이지 + 페이지 장기 토큰 필요.
# env 대신 Supabase app_settings 에 넣어도 동작(FACEBOOK_PAGE_ID/FACEBOOK_PAGE_ACCESS_TOKEN).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# AI 문구 생성 - 우선순위: Gemini(무료) > Anthropic(유료) > 프리셋 폴백
# ① Gemini (권장·무료 등급). Google AI Studio(aistudio.google.com/apikey) 에서 발급
GEMINI_API_KEY=
# 사용할 Gemini 모델 (기본값: gemini-flash-lite-latest, 무료 등급)
GEMINI_MODEL=
# ② Anthropic (선택). GEMINI_API_KEY 가 없을 때만 사용
AI_API_KEY=
# 사용할 Anthropic 모델 (기본값: claude-opus-4-8)
AI_MODEL=

# 관리자 페이지(/admin) 접근 비밀번호
ADMIN_SECRET=

# Vercel Cron 인증용 시크릿 (매일 자동 스카우트/성과 리포트).
# 임의의 랜덤 문자열. Vercel 환경변수에도 같은 값을 넣어야 cron 이 인증된다.
# (Vercel Cron 은 이 값을 Authorization: Bearer 헤더로 자동 전송)
CRON_SECRET=

# (선택) 텔레그램 "영상" 승인 직후 GitHub Actions 클라우드 렌더를 즉시 깨우기.
# 없어도 15분 주기 스케줄이 알아서 렌더한다. Vercel 환경변수에만 설정.
# GH_DISPATCH_TOKEN: GitHub fine-grained PAT (이 저장소 Actions: Read and write)
GH_DISPATCH_TOKEN=
# GH_REPOSITORY: owner/repo 형식 (예: keun4jang/coupang-partners-shop)
GH_REPOSITORY=
# GH_BRANCH: 워크플로를 실행할 브랜치 (기본: 프로덕션 브랜치)
GH_BRANCH=

# (선택) 렌더 워커에서 사용할 Chromium 실행 파일 경로
# 비워두면 Remotion이 자동으로 브라우저를 받는다
REMOTION_BROWSER_EXECUTABLE=

# (권장) SNS 업로드 슬롯 - 하루 영상을 아침/점심/저녁에 나눠 올린다 (KST, 콤마 구분).
# 각 시각에 날짜별 랜덤 지터(±30분)가 자동으로 더해져 매일 조금씩 다른 시각에 올라간다.
# 미설정 시 렌더 워커가 대기중 영상을 즉시 전부 처리한다. (GitHub WORKER_ENV 에 설정)
UPLOAD_SCHEDULE=08:40,13:00,19:00
