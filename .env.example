# ─────────────────────────────────────────────────────────────
# 살림템 메모장 - 환경변수 예시
# 실제 값은 .env.local (로컬) / Vercel 환경변수 (배포)에 넣는다.
# 이 파일에는 절대 실제 키를 넣지 않는다.
# ─────────────────────────────────────────────────────────────

# 사이트 공개 URL (예: https://salimtem.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Supabase (프로젝트 설정 > API 에서 확인)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot (@BotFather 에서 발급)
TELEGRAM_BOT_TOKEN=
# 명령을 허용할 채팅 ID (본인 chat id)
TELEGRAM_ALLOWED_CHAT_ID=
# [필수] webhook 설정 시 secret_token 으로 등록한 값 (임의의 랜덤 문자열).
# 이 값이 없으면 /api/telegram 이 모든 요청을 거부한다 (chat id 만으로는
# 요청 출처를 검증할 수 없어 인증 없이 봇 명령이 실행될 수 있기 때문).
TELEGRAM_WEBHOOK_SECRET=

# Google Drive (서비스 계정 - Drive API 사용, 대상 폴더를 서비스 계정 이메일과 공유할 것)
GOOGLE_CLIENT_EMAIL=
# 개인키는 줄바꿈을 \n 으로 이스케이프해서 한 줄로 넣는다
GOOGLE_PRIVATE_KEY=
# 업로드 대상 루트 폴더 ID (coupang-shorts 폴더)
GOOGLE_DRIVE_FOLDER_ID=

# AI 문구 생성 (Anthropic API Key)
AI_API_KEY=
# 사용할 모델 (기본값: claude-opus-4-8)
AI_MODEL=

# 관리자 페이지(/admin) 접근 비밀번호
ADMIN_SECRET=

# (선택) 렌더 워커에서 사용할 Chromium 실행 파일 경로
# 비워두면 Remotion이 자동으로 브라우저를 받는다
REMOTION_BROWSER_EXECUTABLE=
