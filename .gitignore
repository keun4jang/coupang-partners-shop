# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - 민감 정보는 절대 커밋하지 않는다 (.env.example만 커밋)
.env*
!.env.example

# video render output / remotion cache
/var/
/renders/
.remotion/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
